# Copy this file to ".env" and paste your real key below.
# Get a key from: https://app.fashn.ai/api  (Developer API dashboard -> Create new API key)
#
# If FASHN_API_KEY is left empty or missing, the app automatically runs in
# DEMO MODE — it will never pretend a fake result is real AI.
FASHN_API_KEY=

# Optional — change the local port (default 3000)
PORT=3000
